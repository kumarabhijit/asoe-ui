# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# FastAPI Backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# SSO / OIDC (configure per IdP)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_ISSUER_URL=

# Feature flags
# Set to "false" to hide preview/upcoming feature tabs (SAP Data, Change Analysis)
# Default: shown (any value other than "false" shows preview features)
NEXT_PUBLIC_SHOW_PREVIEW_FEATURES=true
