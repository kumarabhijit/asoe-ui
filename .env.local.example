# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# FastAPI Backend (local asoe2 sandbox — see docs/full-stack-local.md)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Live-backend switch. Unset / "0" => the UI serves the in-repo MOCK_*
# fixtures (Vercel-preview shape, no backend needed). "1" => the API client
# talks to the asoe2 sandbox at NEXT_PUBLIC_API_URL for full-stack local dev.
NEXT_PUBLIC_USE_REAL_API=0

# SSO / OIDC (configure per IdP)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_ISSUER_URL=

# Feature flags
# Set to "false" to hide preview/upcoming feature tabs (SAP Data, Change Analysis)
# Default: shown (any value other than "false" shows preview features)
NEXT_PUBLIC_SHOW_PREVIEW_FEATURES=true
