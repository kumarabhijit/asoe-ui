{
  "name": "asoe-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "mkdir -p reports && vitest run --reporter=default --reporter=junit --outputFile=reports/vitest-junit.xml",
    "test:ci:metrics": "node scripts/junit-to-prometheus.mjs --input reports/vitest-junit.xml --output reports/vitest-metrics.prom --mode mock",
    "typecheck": "tsc --noEmit",
    "generate-types": "openapi-typescript ../asoe2/openapi/asoe2.openapi.json -o src/types/generated.ts",
    "verify-types": "openapi-typescript ../asoe2/openapi/asoe2.openapi.json -o /tmp/asoe-ui.generated.ts && diff -q src/types/generated.ts /tmp/asoe-ui.generated.ts",
    "sync:reason-tags": "node scripts/sync-reason-tag-snapshot.mjs",
    "verify:reason-tags": "node scripts/sync-reason-tag-snapshot.mjs && git diff --exit-code -- tests/contract/snapshots/curated_reason_tags.json src/lib/__generated__/curated_reason_tags.ts",
    "sync:ui-routes": "node scripts/extract-ui-routes.mjs",
    "verify:ui-routes": "node scripts/extract-ui-routes.mjs && git diff --exit-code -- tests/contract/snapshots/ui_route_surface.json",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:browser:headed": "playwright test --headed",
    "flows:matrix": "tsx e2e/journey-matrix.ts",
    "flows:gen": "tsx e2e/flows-gen.ts",
    "flows:coverage": "tsx scripts/coverage-report.ts",
    "flows:coverage:check": "tsx scripts/coverage-report.ts --check",
    "flows:check": "tsx e2e/flows-gen.ts --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/dagre": "^0.7.54",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "fuse.js": "^7.3.0",
    "lucide-react": "^0.460.0",
    "next": "^16.0.0",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.10.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.8.4"
  }
}
